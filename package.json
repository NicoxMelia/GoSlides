{
  "name": "goslides-platform",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "prepare:presentations": "node scripts/build-public-library.mjs",
    "dev:studio": "node scripts/build-public-library.mjs && vite --config vite.studio.config.ts --open /studio.html",
    "dev:viewer": "node scripts/build-public-library.mjs && vite --config vite.viewer.config.ts",
    "build:viewer": "tsc -b && node scripts/build-public-library.mjs && vite build --config vite.viewer.config.ts && node scripts/create-spa-fallback.mjs",
    "build:studio": "tsc -b && node scripts/build-public-library.mjs && vite build --config vite.studio.config.ts",
    "build:goserver-viewer": "VITE_BASE_PATH=/app/goslides/ npm run build:viewer",
    "build:goserver-studio": "VITE_BASE_PATH=/app/goslides-studio/ npm run build:studio && cp dist-studio/studio.html dist-studio/index.html",
    "preview:viewer": "vite preview --outDir dist",
    "pack:demo": "node scripts/pack-demo.mjs",
    "pack:sast": "node scripts/pack-sast.mjs",
    "audit": "node scripts/audit-presentations.mjs",
    "regression": "node scripts/regression-checks.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
